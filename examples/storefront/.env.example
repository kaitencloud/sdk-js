# Copy this file to .env, fill in all five variables, and run `vp dev`. With none of them set the
# storefront runs against a stand-in for Kaiten; with some of them it refuses to start. A variable
# of your shell wins over this file, even when it is empty. .env is git-ignored. Never prefix them
# with VITE_: these stay on the server.

# Your Kaiten API's URL, /api included.
KAITEN_API_URL=

# A ksh_ service-account token that holds write:customer_sessions. It never leaves the server.
KAITEN_API_TOKEN=

# A publishable key (pk_) whose allowed origins include the storefront's, e.g. http://localhost:5173 (or the --port you use).
KAITEN_PUBLISHABLE_KEY=

# The slug of the customer the storefront signs in as.
STOREFRONT_CUSTOMER_SLUG=

# The slug of one of that customer's instances: the one a checkout subscribes.
STOREFRONT_INSTANCE_SLUG=
