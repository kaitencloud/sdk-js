# Copy this file to .env, fill it in, and run `vp dev`. With none of the variables set the storefront
# runs against a stand-in for Kaiten. With the first three it runs against your Kaiten, and then:
#   - both slugs set: it signs in that one customer;
#   - neither slug set: visitors sign up (each makes a customer and an instance of their own, on your
#     catalogue's free plan: publish one, there is no sign-up without it);
#   - one slug alone: it refuses to start, and says which is missing.
# A variable of your shell wins over this file, even when it is empty. .env is git-ignored. Never prefix them
# with VITE_: these stay on the server. Vite expands $NAME in a value: write a literal $ as \$.

# Your Kaiten API's URL, /api included.
KAITEN_API_URL=

# A ksh_ service-account token. It never leaves the server. It holds write:customer_sessions and, to let
# visitors sign up (no slugs below), write:customers and write:instances too.
KAITEN_API_TOKEN=

# A publishable key (pk_) whose allowed origins include the storefront's, e.g. http://localhost:5173 (or the --port you use).
KAITEN_PUBLISHABLE_KEY=

# Optional, together with the next one: the slug of the customer the storefront signs in as.
# Leave both empty to let visitors sign up.
STOREFRONT_CUSTOMER_SLUG=

# Optional, together with the previous one: the slug of one of that customer's instances, the one a
# checkout subscribes.
STOREFRONT_INSTANCE_SLUG=

# Optional, sign-up mode: 32 characters or more, to sign the cookie that remembers a visitor's account.
# Without it a key is made at each start and the accounts are forgotten when the server restarts.
STOREFRONT_COOKIE_SECRET=
