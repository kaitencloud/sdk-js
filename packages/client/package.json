{
  "name": "@kaitencloud/client",
  "version": "1.0.0",
  "description": "Kaiten browser client — catalogue, licensing snapshot, usage reports and flag evaluation; it never holds a secret",
  "homepage": "https://github.com/kaitencloud/sdk-js/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/kaitencloud/sdk-js/issues"
  },
  "license": "Apache-2.0",
  "author": "Kaiten",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaitencloud/sdk-js.git",
    "directory": "packages/client"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./testing": "./dist/testing.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "generate-graphql": "graphql-codegen --config codegen.ts",
    "generate": "vp exec openapi-ts"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/client-preset": "catalog:",
    "@graphql-typed-document-node/core": "catalog:",
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "catalog:",
    "graphql": "catalog:",
    "typescript": "catalog:codegen",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.4.1"
}
