{
  "name": "@kaitencloud/server",
  "version": "1.0.0",
  "description": "Kaiten server SDK for Node — full typed contract surface (Bearer auth).",
  "homepage": "https://github.com/kaitencloud/sdk-js/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/kaitencloud/sdk-js/issues"
  },
  "license": "Apache-2.0",
  "author": "Kaiten",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaitencloud/sdk-js.git",
    "directory": "packages/server"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "generate": "vp exec openapi-ts"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "catalog:",
    "typescript": "catalog:codegen",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.4.1"
}
